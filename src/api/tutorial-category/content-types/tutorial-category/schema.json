{
  "kind": "collectionType",
  "collectionName": "tutorial_categories",
  "info": {
    "singularName": "tutorial-category",
    "pluralName": "tutorial-categories",
    "displayName": "Tutorial Category",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
